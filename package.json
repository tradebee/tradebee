{
  "name": "tradebee",
  "version": "26.9.30",
  "description": "Connect OpenClaw to the Tradebee MCP service to query, analyze, and manage website content and data.",
  "author": "Tradebee",
  "keywords": [
    "tradebee",
    "openclaw",
    "mcp",
    "website"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    ".codex-plugin",
    "assets",
    "dist",
    ".mcp.json",
    "LICENSE",
    "openclaw.plugin.json",
    "README.md",
    "tool.schema.json",
    "skills",
    "connector-meta.json",
    "icon.svg",
    "mcp.json",
    "token-schema.json"
  ],
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "openclaw": "2026.8.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:tradebee",
      "minHostVersion": ">=2026.5.17"
    },
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": "2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.8.2",
      "pluginSdkVersion": "2026.8.2"
    }
  }
}
